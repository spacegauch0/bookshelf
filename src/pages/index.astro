  <span class="tb-divider"></span>
  <div class="tb-search">
    <svg class="tb-search-icon" width="21" height="21" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><circle cx="6" cy="6" r="4"/><path d="M9.5 9.5L13 13"/></svg>
