---
import books from "../data/books.json";
import annotationsRaw from "../data/annotations.json";
import clippingsRaw from "../data/clippings-annotations.json";

// Merge both annotation sources
const allAnnotations = [...(Array.isArray(annotationsRaw) ? annotationsRaw : []), ...(Array.isArray(clippingsRaw) ? clippingsRaw : [])];
const annotationsList = allAnnotations.map((a) => ({ title: a.title?.trim(), highlights: (a.annotations || []).map((h) => typeof h === "string" ? h : h.text) }));

// Manual title overrides for translations / alternate editions
const titleOverrides = {
  "la sabiduria de la inseguridad": "The Wisdom of Insecurity: A Message for an Age of Anxiety",
};

function resolveTitle(t) {
  return titleOverrides[t.toLowerCase().trim()] || t;
}

function attachHighlights(book) {
  const t = book.title.toLowerCase().trim();
  for (const entry of annotationsList) {
    const et = resolveTitle(entry.title).toLowerCase();
    if (t === et || t.includes(et) || et.includes(t)) {
      return { ...book, highlights: entry.highlights };
    }
  }
  return book;
}

const enrichedBooks = books.map(attachHighlights);

function shuffle(arr) {
  const a = [...arr];
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}

const repeats = 6;
const allBooks = [];
for (let r = 0; r < repeats; r++) {
  allBooks.push(...shuffle(enrichedBooks));
}
---

<!doctype html>
<html lang="en" class="no-js">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Diego's Bookshelf</title>
  <style is:global>
    *, *::after, *::before { box-sizing:border-box; margin:0; padding:0; }

    :root {
      --bg: #000;
      --c-gap: 4px;
      --r-gap: 4px;
      --col-size: 120px;
      --col-count: 5;
    }

    body {
      color: #fff;
      background: var(--bg);
      font-family: Georgia, "Times New Roman", serif;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    @media (scripting: enabled) {
      .loading::before, .loading::after { content:''; position:fixed; z-index:10000; }
      .loading::before { inset:0; background:var(--bg); }
      .loading::after {
        top:50%; left:50%; width:80px; height:1px; margin-left:-40px;
        background:#333;
        animation:loader 1.5s ease-in-out infinite alternate forwards;
      }
    }
    @keyframes loader {
      0% { transform:scaleX(0); transform-origin:0% 50%; }
      50% { transform:scaleX(1); transform-origin:0% 50%; }
      50.1% { transform:scaleX(1); transform-origin:100% 50%; }
      100% { transform:scaleX(0); transform-origin:100% 50%; }
    }

    #smooth-wrapper { overflow:visible; }

    .grid {
      display:grid; padding:0; margin:0 auto;
      grid-template-columns:repeat(var(--col-count), minmax(var(--col-size), 1fr));
      column-gap:var(--c-gap); row-gap:var(--r-gap);
    }
    .grid__item { margin:0; }
    .grid__item-img {
      aspect-ratio:2/3; background-size:cover; background-position:center;
      border-radius:2px 5px 5px 2px; cursor:pointer; position:relative; overflow:hidden;
    }
    .grid__item-img::after {
      content:''; position:absolute; inset:0; border-radius:inherit;
      box-shadow:inset 1px 0 2px rgba(255,255,255,0.04), 0 1px 3px rgba(0,0,0,0.3);
      pointer-events:none;
    }
    .grid__item-img .tag {
      position:absolute; top:4px; right:4px; font-size:8px; font-weight:700; letter-spacing:0.05em;
      padding:2px 5px; border-radius:3px; font-family:system-ui,sans-serif; pointer-events:none; z-index:2;
    }
    .tag.read { background:#1a3018; color:#6a9a58; }
    .tag.current { background:#302808; color:#b89828; }
    .tag.tbr { background:#1a0c0c; color:#7a5a4a; }
    .grid__item-caption { font-size:10px; font-weight:500; margin-top:2px; color:#444; display:none; }
    .grid__column { display:flex; flex-direction:column; gap:var(--c-gap); }

    /* Toolbar — macOS Spotlight style */
    .tb {
      position:fixed; top:24px; left:50%; transform:translateX(-50%); z-index:100;
      display:flex; align-items:center; gap:3px;
      background:rgba(28,28,30,0.85); backdrop-filter:blur(28px) saturate(1.8);
      border:1px solid rgba(255,255,255,0.08); border-radius:9999px;
      padding:6px 9px; box-shadow:0 4px 24px rgba(0,0,0,0.5), 0 0 0 0.5px rgba(255,255,255,0.06) inset;
      max-width:calc(100vw - 32px);
      overflow:hidden;
    }
    .tb-brand {
      font-size:18px; font-weight:600; color:#888;
      font-family:system-ui,-apple-system,sans-serif;
      padding:6px 8px 6px 18px; white-space:nowrap;
      letter-spacing:-0.01em;
      display:flex; align-items:center; gap:10px;
    }
    .tb-logo { flex-shrink:0; }
    .tb-divider {
      width:1px; height:30px; background:rgba(255,255,255,0.08);
      margin:0 3px; flex-shrink:0;
    }
    .tb-search {
      position:relative;
    }
    .tb-search input {
      width:270px; background:none; border:none;
      color:#ccc; font-size:19px; padding:12px 21px 12px 48px;
      outline:none; font-family:system-ui,-apple-system,sans-serif;
      letter-spacing:-0.01em;
      transition:width 0.35s cubic-bezier(0.25,0.46,0.45,0.94);
    }
    .tb-search input:focus { width:360px; }
    .tb-search input::placeholder { color:#555; }
    .tb-search-icon {
      position:absolute; left:15px; top:50%; transform:translateY(-50%);
      color:#666; pointer-events:none; transition:color 0.2s;
    }
    .tb-search:focus-within .tb-search-icon { color:#888; }
    .tb-search-results {
      position:absolute; top:calc(100% + 12px); left:0; right:0;
      background:rgba(15,15,15,0.9); backdrop-filter:blur(24px) saturate(1.5);
      border:1px solid rgba(255,255,255,0.08); border-radius:18px;
      max-height:540px; overflow-y:auto;
      display:none; box-shadow:0 12px 40px rgba(0,0,0,0.5);
      opacity:0; transform:translateY(-8px);
      transition:opacity 0.2s ease, transform 0.25s cubic-bezier(0.25,0.46,0.45,0.94);
    }
    .tb-search-results.on { display:block; opacity:1; transform:translateY(0); }
    .tb-result {
      display:flex; align-items:center; gap:18px;
      padding:15px 21px; cursor:pointer;
      transition:background 0.15s;
      opacity:0; transform:translateX(-8px);
      animation:tbSlideIn 0.25s cubic-bezier(0.25,0.46,0.45,0.94) forwards;
    }
    .tb-result:nth-child(1) { animation-delay:0.02s; }
    .tb-result:nth-child(2) { animation-delay:0.05s; }
    .tb-result:nth-child(3) { animation-delay:0.08s; }
    .tb-result:nth-child(4) { animation-delay:0.11s; }
    .tb-result:nth-child(5) { animation-delay:0.14s; }
    .tb-result:nth-child(6) { animation-delay:0.17s; }
    .tb-result:nth-child(7) { animation-delay:0.20s; }
    .tb-result:nth-child(8) { animation-delay:0.23s; }
    @keyframes tbSlideIn {
      to { opacity:1; transform:translateX(0); }
    }
    .tb-result:first-child { border-radius:18px 18px 0 0; }
    .tb-result:last-child { border-radius:0 0 18px 18px; }
    .tb-result:hover { background:rgba(255,255,255,0.05); }
    .tb-result-cover {
      width:42px; height:63px; border-radius:3px 6px 6px 3px;
      background-size:cover; background-position:center;
      flex-shrink:0;
    }
    .tb-result-info { min-width:0; }
    .tb-result-title { font-size:18px; color:#ccc; line-height:1.3; font-family:system-ui,-apple-system,sans-serif; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .tb-result-author { font-size:15px; color:#666; font-family:system-ui,-apple-system,sans-serif; }
    .tb-result-empty { padding:24px 21px; font-size:18px; color:#555; text-align:center; font-family:system-ui,sans-serif; }

    .tb-search-results::-webkit-scrollbar { width:4px; }
    .tb-search-results::-webkit-scrollbar-track { background:transparent; }
    .tb-search-results::-webkit-scrollbar-thumb { background:rgba(255,255,255,0.08); border-radius:2px; }

    /* Filter chips inside toolbar */
    .tb-filters {
      display:flex; align-items:center; gap:4px;
      padding-right:6px;
      overflow-x:auto;
    }
    .tb-filters::-webkit-scrollbar { display:none; }
    .tb-chip {
      background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.06);
      color:#666; font-size:16px; padding:6px 18px; border-radius:9999px;
      cursor:pointer; font-family:system-ui,-apple-system,sans-serif;
      font-weight:500; white-space:nowrap;
      transition:all 0.25s cubic-bezier(0.25,0.46,0.45,0.94);
      user-select:none;
    }
    .tb-chip:hover {
      color:#aaa; border-color:rgba(255,255,255,0.12);
      background:rgba(255,255,255,0.06);
    }
    a.tb-chip { text-decoration:none; }
    .tb-chip.active {
      color:#fff; border-color:rgba(255,255,255,0.2);
      background:rgba(255,255,255,0.1);
      box-shadow:0 0 12px rgba(255,255,255,0.04);
    }
    .tb-chip-hl {
      background:linear-gradient(135deg, rgba(124,184,104,0.1), rgba(200,180,60,0.06));
      border-color:rgba(124,184,104,0.2);
      color:#aaa;
      box-shadow:0 0 14px rgba(124,184,104,0.06);
    }
    .tb-chip-hl:hover {
      background:linear-gradient(135deg, rgba(124,184,104,0.15), rgba(200,180,60,0.1));
      border-color:rgba(124,184,104,0.3);
      color:#ddd;
      box-shadow:0 0 20px rgba(124,184,104,0.12);
    }

    /* Dimmed grid items */
    .grid__item.dimmed .grid__item-img {
      opacity:0.12; transition:opacity 0.4s cubic-bezier(0.25,0.46,0.45,0.94);
    }
    .grid__item .grid__item-img { transition:opacity 0.4s cubic-bezier(0.25,0.46,0.45,0.94); }

    @media (max-width:900px) {
      .tb-brand { font-size:15px; padding:5px 6px 5px 14px; gap:8px; }
      .tb-brand .tb-logo { width:20px; height:25px; }
      .tb-search input { width:200px; font-size:16px; padding:10px 16px 10px 36px; }
      .tb-search input:focus { width:260px; }
      .tb-search-icon { left:12px; }
      .tb-chip { font-size:14px; padding:5px 14px; }
    }

    @media (max-width:640px) {
      .tb { gap:2px; padding:5px 6px; top:18px; }
      .tb-brand { display:none; }
      .tb-divider { display:none; }
      .tb-search input { width:180px; font-size:18px; padding:10px 15px 10px 42px; }
      .tb-search input:focus { width:225px; }
      .tb-chip { font-size:15px; padding:5px 12px; }
    }

    @media (min-width:65em) { :root { --col-count:8; } }
    @media (min-width:85em) { :root { --col-count:10; } }
    @media (min-width:110em) { :root { --col-count:12; } }
    @media (max-width:48em) { :root { --col-count:3; --col-size:90px; --c-gap:3px; --r-gap:3px; } }
    @media (max-width:30em) { :root { --col-count:2; --col-size:70px; --c-gap:2px; --r-gap:2px; } }

    /* Lightbox */
    .lb-overlay {
      position:fixed; inset:0; z-index:200; pointer-events:none;
      background:rgba(0,0,0,0); backdrop-filter:blur(0px);
    }
    .lb-overlay.on {
      background:rgba(0,0,0,0.9); pointer-events:auto; backdrop-filter:blur(8px);
      transition:background 0.55s, backdrop-filter 0.55s;
    }
    .lb-close {
      position:fixed; top:16px; right:16px; z-index:310; width:44px; height:44px; border-radius:50%;
      border:1px solid rgba(255,255,255,0.1); background:rgba(0,0,0,0.5); color:#888;
      cursor:pointer; display:flex; align-items:center; justify-content:center;
      opacity:0; pointer-events:none; backdrop-filter:blur(10px); padding:0;
      transition:opacity 0.35s, color 0.2s, border-color 0.2s;
    }
    .lb-close.on { opacity:1; pointer-events:auto; }
    .lb-close:hover { color:#fff; border-color:rgba(255,255,255,0.2); background:rgba(255,255,255,0.08); }

    /* Detail page */
    .lb-detail {
      position:fixed; inset:0; z-index:300; overflow-y:auto; overflow-x:hidden;
      overscroll-behavior:none; opacity:0; pointer-events:none; transition:opacity 0.4s;
    }
    .lb-detail.on { opacity:1; pointer-events:auto; }
    .lb-detail-inner {
      display:grid; grid-template-columns:1fr 1fr; grid-template-rows:auto 1fr;
      gap:0; min-height:100vh;
    }
    .lb-detail-aside {
      grid-column:1; grid-row:1/3; position:sticky; top:0; height:100vh;
      display:flex; align-items:center; justify-content:center; padding:60px;
      border-right:1px solid rgba(255,255,255,0.04);
      overflow:hidden;
      isolation:isolate;
    }
    .lb-detail-aside::before {
      content:""; position:absolute; inset:0; z-index:0;
      background-image:var(--cover-bg);
      background-size:cover; background-position:center;
      filter:blur(30px) brightness(0.4);
    }
    .lb-detail-aside img {
      position:relative; z-index:1;
      max-width:100%; max-height:80vh; object-fit:contain;
      border-radius:3px 8px 8px 3px; box-shadow:0 4px 24px rgba(0,0,0,0.5);
    }
    .lb-detail-header { grid-column:2; grid-row:1; padding:80px 80px 0; }
    .lb-detail-body { grid-column:2; grid-row:2; padding:0 80px 120px; max-width:620px; }

    .lb-detail h2 {
      font-size:clamp(2.5rem, 5vw, 4.5rem); font-weight:900; color:#f5f5f5;
      line-height:0.95; margin-bottom:12px;
      font-family:system-ui,-apple-system,"Helvetica Neue",sans-serif; letter-spacing:-0.03em;
    }
    .lb-author { font-size:1.25rem; color:#666; margin-bottom:8px; font-family:system-ui,-apple-system,"Helvetica Neue",sans-serif; font-weight:500; }
    .lb-meta { font-size:0.7rem; color:#555; margin-bottom:6px; font-family:system-ui,monospace; text-transform:uppercase; letter-spacing:0.1em; }
    .lb-ratings { margin:32px 0 0; display:flex; gap:20px; align-items:baseline; }
    .lb-user-rating { font-size:1.1rem; color:#e0c040; font-family:system-ui,-apple-system,sans-serif; font-weight:600; }
    .lb-avg-rating { font-size:0.8rem; color:#555; font-family:system-ui,-apple-system,sans-serif; }
    .lb-shelves { display:flex; flex-wrap:wrap; gap:8px; margin:24px 0 0; align-items:center; }
    .lb-badge {
      font-size:0.625rem; padding:5px 14px; border-radius:100px; background:rgba(255,255,255,0.04);
      color:#888; text-transform:uppercase; letter-spacing:0.07em;
      border:1px solid rgba(255,255,255,0.06); font-family:system-ui,-apple-system,sans-serif; font-weight:600;
    }
    .lb-badge.read { background:rgba(70,150,50,0.12); color:#7cb868; border-color:rgba(70,150,50,0.2); }
    .lb-badge.currently-reading { background:rgba(180,140,30,0.12); color:#d0b030; border-color:rgba(180,140,30,0.2); }
    .lb-sec { margin-top:48px; }
    .lb-sec h3 {
      font-size:0.6rem; text-transform:uppercase; letter-spacing:0.15em; color:#555;
      margin-bottom:16px; font-family:system-ui,-apple-system,sans-serif; font-weight:700;
    }
    .lb-sec p { font-size:1.1rem; line-height:1.8; color:#999; font-family:system-ui,-apple-system,"Helvetica Neue",sans-serif; }
    .lb-review { font-size:1.15rem; font-style:italic; color:#bbb; border-left:3px solid rgba(255,255,255,0.06); padding:8px 0 8px 24px; }
    .lb-empty { font-size:1rem; color:#444; line-height:1.7; }
    .lb-empty a { color:#7cb868; text-decoration:underline; }
    .lb-link {
      display:inline-block; margin-top:48px; font-size:0.75rem; color:#555; text-decoration:none;
      transition:color 0.2s; font-family:system-ui,-apple-system,sans-serif; font-weight:500; letter-spacing:0.05em;
    }
    .lb-link:hover { color:#999; }
    .lb-detail::-webkit-scrollbar { width:4px; }
    .lb-detail::-webkit-scrollbar-track { background:transparent; }
    .lb-detail::-webkit-scrollbar-thumb { background:rgba(255,255,255,0.05); border-radius:2px; }

    /* Highlight slider */
    .hl-slider { margin-top:40px; }
    .hl-slider h3 {
      font-size:0.6rem; text-transform:uppercase; letter-spacing:0.15em; color:#555;
      margin-bottom:12px; font-family:system-ui,-apple-system,sans-serif; font-weight:700;
    }
    .hl-counter { font-weight:400; margin-left:6px; font-family:system-ui,monospace; }
    .hl-stage {
      overflow:hidden; border-radius:6px; background:rgba(255,255,255,0.02);
      border:1px solid rgba(255,255,255,0.04); position:relative; min-height:80px;
      transition:height 0.4s cubic-bezier(0.25,0.46,0.45,0.94);
      max-width:100%;
    }
    .hl-track { display:flex; align-items:flex-start; will-change:transform; transition:transform 0.4s cubic-bezier(0.25,0.46,0.45,0.94); }
    .hl-card {
      flex-shrink:0; padding:40px 36px;
      word-wrap:break-word; overflow-wrap:break-word;
      position:relative;
    }
    .hl-card::before {
      content:"\201C";
      position:absolute;       top:15px; left:8px;
      font-size:8rem; line-height:1;
      font-family:Georgia,"Times New Roman",serif;
      color:rgba(255,255,255,0.03);
      pointer-events:none;
    }
    .hl-card p {
      position:relative; z-index:1;
      font-size:1.25rem; line-height:1.65; font-weight:500;
      font-style:italic; color:#ccc;
      font-family:Georgia,"Times New Roman",serif;
      margin:0 0 14px;
      word-break:break-word; overflow-wrap:break-word; hyphens:auto;
    }
    .hl-card cite {
      position:relative; z-index:1;
      display:block; font-size:0.7rem; color:#555;
      font-style:normal; font-family:system-ui,monospace;
      word-break:break-word;
    }
    .hl-nav { display:flex; align-items:center; justify-content:space-between; margin-top:12px; }
    .hl-nav button {
      background:none; border:1px solid rgba(255,255,255,0.06); color:#888; width:32px; height:32px;
      border-radius:50%; cursor:pointer; display:flex; align-items:center; justify-content:center;
      transition:all 0.2s; flex-shrink:0;
    }
    .hl-nav button:hover { color:#fff; border-color:rgba(255,255,255,0.15); background:rgba(255,255,255,0.04); }
    .hl-nav button:disabled { opacity:0.2; cursor:default; }
    .hl-dots { display:flex; gap:6px; }
    .hl-dots span { width:5px; height:5px; border-radius:50%; background:rgba(255,255,255,0.08); transition:background 0.2s; }
    .hl-dots span.on { background:rgba(255,255,255,0.3); }

    @media (max-width:900px) {
      .lb-detail-inner { grid-template-columns:1fr; grid-template-rows:auto; gap:0; overflow:hidden; }
      .lb-detail-aside { grid-column:1; grid-row:1; height:auto; min-height:40vh; position:relative; border-right:none; border-bottom:1px solid rgba(255,255,255,0.04); padding:40px 32px; }
      .lb-detail-header { grid-column:1; grid-row:2; padding:40px 32px 0; overflow:hidden; }
      .lb-detail-body { grid-column:1; grid-row:3; padding:0 32px 80px; max-width:none; overflow:hidden; }
      .lb-detail h2 { font-size:2rem; word-break:break-word; }
      .lb-detail-aside img { max-height:35vh; }
      .hl-slider { max-width:100%; }
    }
    @media (max-width:640px) {
      .lb-close { top:12px; right:12px; width:38px; height:38px; }
      .lb-detail-aside { min-height:30vh; padding:32px 24px; }
      .lb-detail-header { padding:32px 24px 0; }
      .lb-detail-body { padding:0 24px 64px; }
      .lb-detail h2 { font-size:1.5rem; hyphens:auto; }
      .lb-author { font-size:1rem; }
      .lb-sec p { font-size:0.95rem; word-break:break-word; }
      .hl-card { padding:24px 20px; word-break:break-word; overflow-wrap:break-word; }
      .hl-card::before { font-size:5rem; top:10px; left:4px; }
      .hl-card p { font-size:0.95rem; hyphens:auto; }
      .hl-nav button { width:28px; height:28px; }
    }
  </style>
  <script>document.documentElement.className="js";</script>
</head>
<body class="loading">

<div id="smooth-wrapper">
  <main id="smooth-content">
    <div class="grid" id="grid">
      {allBooks.map((book) => {
        const isRead = book.shelves.includes("read");
        const isCurrent = book.shelves.includes("currently-reading");
        const hasHighlights = book.highlights && book.highlights.length > 0;
        return (
          <figure class="grid__item" data-id={book.id} data-shelves={book.shelves.join(",")} data-highlights={hasHighlights ? "1" : "0"}>
            <div class="grid__item-img" style={`background-image:url(${book.imageUrl})`}>
              <span class={`tag ${isRead ? "read" : isCurrent ? "current" : "tbr"}`}>{isRead ? "READ" : isCurrent ? "NOW" : "TBR"}</span>
            </div>
            <figcaption class="grid__item-caption">{book.title}</figcaption>
          </figure>
        );
      })}
    </div>
  </div>
</div>

<div class="tb" id="toolbar">
  <span class="tb-brand">
